# ============================================================
# GuideBard Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Deployment mode: single_tenant (self-hosted) | multi_tenant (SaaS)
DEPLOYMENT_MODE=single_tenant

# ── Security ────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SECRET_KEY=change-me-generate-with-openssl-rand-hex-64

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# JWT token lifetimes (seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# ── Database ─────────────────────────────────────────────────
DB_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://guidebard:${DB_PASSWORD}@postgres:5432/guidebard
DATABASE_URL_SYNC=postgresql://guidebard:${DB_PASSWORD}@postgres:5432/guidebard

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO / Object Storage ────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=guidebard-minio
MINIO_SECRET_KEY=change-me-strong-minio-password
MINIO_USE_SSL=false
MINIO_BUCKET_PREFIX=guidebard

# ── (Optional) AWS S3 instead of MinIO for hosted SaaS ───────
# USE_S3=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# ── App Branding ──────────────────────────────────────────────
APP_NAME=GuideBard
APP_URL=http://localhost

# ── Single-Tenant Bootstrap (DEPLOYMENT_MODE=single_tenant) ──
# Set these before first run; setup.sh will use them
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me-admin-password

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/ws
NEXT_PUBLIC_APP_NAME=GuideBard
NEXT_PUBLIC_DEPLOYMENT_MODE=single_tenant

# ── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── FFmpeg ────────────────────────────────────────────────────
FFMPEG_THREADS=4

# ── Optional: Sentry Error Tracking ──────────────────────────
# SENTRY_DSN=

# ── Optional: Stripe (multi_tenant billing) ──────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_MONTHLY=
